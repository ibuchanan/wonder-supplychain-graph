{
  "name": "wonder-supplychain-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "changelog": "git cliff",
    "check": "lefthook run pre-push",
    "clean": "rm -rf ./node_modules ./dist",
    "dev": "tsc -p tsconfig.json --watch",
    "forge:deploy": "cmd=$(fence-rider deploy) && SECRETSPEC_REASON='npm run forge:deploy' sh -c \"$cmd\" sh",
    "forge:install": "cmd=$(fence-rider install -- --non-interactive) && SECRETSPEC_REASON='npm run forge:install' secretspec run --scope '' -- sh scripts/forge-install-both.sh \"$cmd\"",
    "forge:logs": "forge logs | sd \"^[^{]*\" \"\" | jq .",
    "forge:register": "forge register",
    "forge:uninstall": "SECRETSPEC_REASON='npm run forge:uninstall' secretspec run --scope '' -- bash scripts/forge-uninstall-both.sh",
    "forge:upgrade": "cmd=$(fence-rider install -- --upgrade --non-interactive) && SECRETSPEC_REASON='npm run forge:upgrade' secretspec run --scope '' -- sh scripts/forge-install-both.sh \"$cmd\"",
    "forge:variables:generate-shared-secret": "bash scripts/set-shared-secret.sh",
    "forge:variables:set": "SECRETSPEC_REASON='npm run forge:variables:set' fence-rider variables",
    "forge:variables:set:secretspec": "SECRETSPEC_REASON='npm run forge:variables:set:secretspec' fence-rider variables",
    "forge:variables:set-encrypted": "SECRETSPEC_REASON='npm run forge:variables:set-encrypted' fence-rider variables",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "lefthook run lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:forge": "cmd=$(fence-rider lint) && SECRETSPEC_REASON='npm run lint:forge' sh -c \"$cmd\" sh",
    "lint:prelint": "ast-grep scan --config node_modules/@forge-ahead/prelint/sgconfig.ecosol.yml --globs '!node_modules/**' --globs '!vendor/**'",
    "prepare": "lefthook install",
    "size": "npm run size:check",
    "size:check": "npm run build && size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "todo": "rg --glob '!vendor/**' --glob '!package.json' 'TODO' || echo 'No TODOs found!'",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types",
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    "@forge-ahead/triggers": "github:ibuchanan/forge-ahead-triggers",
    "@forge/api": "^8.3",
    "@forge/bridge": "^7.2",
    "@forge/kvs": "^2.1",
    "@forge/react": "^12.3",
    "@forge/resolver": "^2.0",
    "@forge/teamwork-graph": "^5.3",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51",
    "@biomejs/biome": "2.6.2",
    "@forge-ahead/prelint": "github:ibuchanan/tool-forge-prelint-ast-grep",
    "@size-limit/file": "^14.3",
    "@types/node": "24",
    "@types/react-test-renderer": "^18.3",
    "archunit": "^2.5",
    "fence-rider": "github:ibuchanan/ranch-rig-fence-rider",
    "git-cliff": "^2.14",
    "lefthook": "^2.2",
    "react-test-renderer": "^18.3.1",
    "size-limit": "^14.3",
    "typescript": "^5.9",
    "vite": "^8.3",
    "vitest": "^5.0",
    "yaml": "^2.9"
  },
  "size-limit": [
    {
      "name": "Forge app bundle",
      "path": [
        "dist/**/*.js"
      ],
      "limit": "80 kB"
    }
  ]
}
